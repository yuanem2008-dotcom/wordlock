# 复制这个文件为 .env 并按需修改（.env 不会被提交到 git）
# 评测实现：mock（默认，开发用）| tencent | xunfei
SCORER=mock

# —— 用腾讯云口语评测时填写（并确认地域与官方文档一致）——
# TENCENT_SECRET_ID=你的ID
# TENCENT_SECRET_KEY=你的KEY
# TENCENT_SOE_REGION=ap-guangzhou

# —— 用讯飞语音评测时填写 ——
# XUNFEI_APP_ID=你的APPID
# XUNFEI_API_KEY=你的APIKEY
# XUNFEI_API_SECRET=你的APISECRET

# 端口（默认 3000，被占用时换一个）
# PORT=3000

# —— iPad 上使用（要用麦克风必须 HTTPS）——
# 先用 npm run certs 生成证书，再把下面这行打开，然后 npm start
# HTTPS=1
# HTTPS_KEY=./certs/wordlock-key.pem
# HTTPS_CERT=./certs/wordlock.pem
# 监听所有网卡（iPad 要连得进来，默认就是 0.0.0.0）
# HOST=0.0.0.0
